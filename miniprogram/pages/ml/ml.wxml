<view class="page">

  <view class="notice warn" wx:if="{{!connected}}">
    设备未连接，推理由「设备」页连接后使用。
  </view>

  <!-- 实时数值 -->
  <view class="card">
    <view class="card-title">
      <text>实时输出</text>
      <text class="badge {{running ? 'ok' : ''}}">{{running ? '周期推理中' : '已停止'}}</text>
    </view>

    <view class="metric">
      <view class="box">
        <view class="k">输入相位 phase</view>
        <view class="v">{{phaseText}}</view>
      </view>
      <view class="box">
        <view class="k">预测 pred</view>
        <view class="v ok">{{predText}}</view>
      </view>
      <view class="box">
        <view class="k">已收样本</view>
        <view class="v">{{count}}</view>
      </view>
    </view>

    <view class="row" style="margin-top:16rpx">
      <text class="label">单次推理结果 y</text>
      <text class="value mono">{{yText}}</text>
    </view>
  </view>

  <!-- 曲线 -->
  <view class="card">
    <view class="card-title">
      <text>相位 / 预测曲线</text>
      <text class="sub">最近 {{maxSamples}} 点</text>
    </view>
    <canvas type="2d" id="chart" class="chart"></canvas>
    <view class="btn-row" style="margin-top:20rpx">
      <button class="btn small ghost" bindtap="onClear">清空曲线</button>
    </view>
  </view>

  <!-- 控制 -->
  <view class="card">
    <view class="card-title">
      <text>控制</text>
      <text class="sub">0xE0 / 0xE1 / 0xE2</text>
    </view>

    <view class="field">
      <view class="field-label">单次推理输入 x = {{x}}</view>
      <slider min="0" max="100" value="{{xPct}}" activeColor="#2f81f7" backgroundColor="#30363d" block-size="20" bindchanging="onSliding" bindchange="onSlid" />
    </view>

    <view class="btn-row">
      <button class="btn primary" bindtap="onStart" disabled="{{!connected}}">启动周期推理</button>
      <button class="btn ghost" bindtap="onStop" disabled="{{!connected}}">停止</button>
    </view>
    <view class="btn-row" style="margin-top:16rpx">
      <button class="btn" bindtap="onRun" disabled="{{!connected}}">单次推理</button>
    </view>

    <view class="notice" style="margin-top:24rpx;margin-bottom:0">
      启动后固件每完成一次推理就通过 0xABF2 推送 [0xE2][float phase][float pred]（9 字节）；单次推理返回 5 字节。
    </view>
  </view>

</view>
