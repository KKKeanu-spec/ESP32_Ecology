/* ==========================================================================
   RACE 22 调试台 —— 全局样式（与 website/css/style.css 的配色保持一致）
   ========================================================================== */

page {
  --bg: #0d1117;
  --bg-panel: #161b22;
  --bg-elev: #1c2129;
  --border: #262d38;
  --text: #e6edf3;
  --text-dim: #8b98a5;
  --text-faint: #6e7681;
  --accent: #2f81f7;
  --ok: #3fb950;
  --warn: #d29922;
  --err: #f85149;

  background: #0d1117;
  color: #e6edf3;
  font-size: 28rpx;
  line-height: 1.55;
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", "Microsoft YaHei", sans-serif;
  padding-bottom: 40rpx;
  box-sizing: border-box;
}

/* ---------- 布局 ---------- */
.page {
  padding: 24rpx;
}

.card {
  background: #161b22;
  border: 1rpx solid #262d38;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
}

.card-title {
  display: flex;
  align-items: center;
  justify-content: space-between;
  font-size: 28rpx;
  font-weight: 600;
  color: #e6edf3;
  margin-bottom: 20rpx;
}

.card-title .sub {
  font-size: 22rpx;
  font-weight: 400;
  color: #6e7681;
}

/* ---------- 行 ---------- */
.row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 0;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.05);
}

.row:last-child {
  border-bottom: none;
}

.row .label {
  color: #8b98a5;
  font-size: 26rpx;
  flex-shrink: 0;
  margin-right: 24rpx;
}

.row .value {
  color: #e6edf3;
  font-size: 26rpx;
  text-align: right;
  word-break: break-all;
  flex: 1;
}

.value.mono,
.mono {
  font-family: "Cascadia Code", Consolas, "Courier New", monospace;
}

/* ---------- 按钮 ---------- */
.btn {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 84rpx;
  border-radius: 12rpx;
  font-size: 28rpx;
  background: #1c2129;
  color: #e6edf3;
  border: 1rpx solid #30363d;
  margin: 0;
  padding: 0;
  line-height: 1;
}

.btn::after {
  border: none;
}

.btn.primary {
  background: #2f81f7;
  border-color: #2f81f7;
  color: #ffffff;
}

.btn.danger {
  background: rgba(248, 81, 73, 0.12);
  border-color: rgba(248, 81, 73, 0.45);
  color: #f85149;
}

.btn.ghost {
  background: transparent;
}

.btn.small {
  height: 64rpx;
  font-size: 24rpx;
  padding: 0 24rpx;
}

.btn[disabled] {
  opacity: 0.4;
}

.btn-row {
  display: flex;
  gap: 20rpx;
  margin-top: 8rpx;
}

.btn-row .btn {
  flex: 1;
}

/* ---------- 表单 ---------- */
.field {
  margin-bottom: 24rpx;
}

.field .field-label {
  font-size: 24rpx;
  color: #8b98a5;
  margin-bottom: 12rpx;
}

.input {
  background: #0d1117;
  border: 1rpx solid #30363d;
  border-radius: 10rpx;
  height: 80rpx;
  padding: 0 20rpx;
  font-size: 28rpx;
  color: #e6edf3;
  box-sizing: border-box;
  width: 100%;
}

.picker-box {
  background: #0d1117;
  border: 1rpx solid #30363d;
  border-radius: 10rpx;
  height: 80rpx;
  padding: 0 20rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  font-size: 28rpx;
  color: #e6edf3;
}

.picker-box .arrow {
  color: #6e7681;
  font-size: 22rpx;
}

/* ---------- 徽标 ---------- */
.badge {
  display: inline-block;
  padding: 4rpx 14rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  line-height: 1.5;
  background: rgba(139, 152, 165, 0.15);
  color: #8b98a5;
}

.badge.ok {
  background: rgba(63, 185, 80, 0.15);
  color: #3fb950;
}

.badge.err {
  background: rgba(248, 81, 73, 0.15);
  color: #f85149;
}

.badge.warn {
  background: rgba(210, 153, 34, 0.15);
  color: #d29922;
}

.badge.info {
  background: rgba(47, 129, 247, 0.15);
  color: #2f81f7;
}

/* ---------- 列表 ---------- */
.list-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 22rpx 0;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.05);
}

.list-item:last-child {
  border-bottom: none;
}

.list-item .name {
  font-size: 28rpx;
  color: #e6edf3;
  word-break: break-all;
}

.list-item .desc {
  font-size: 22rpx;
  color: #6e7681;
  margin-top: 6rpx;
  word-break: break-all;
}

.list-item .right {
  display: flex;
  align-items: center;
  gap: 16rpx;
  flex-shrink: 0;
  margin-left: 16rpx;
}

/* ---------- 空态 ---------- */
.empty {
  text-align: center;
  color: #6e7681;
  font-size: 26rpx;
  padding: 48rpx 0;
}

/* ---------- 日志 ---------- */
.log-box {
  background: #0d1117;
  border: 1rpx solid #262d38;
  border-radius: 12rpx;
  padding: 16rpx;
  max-height: 560rpx;
  overflow-y: auto;
}

.log-item {
  font-family: "Cascadia Code", Consolas, "Courier New", monospace;
  font-size: 22rpx;
  line-height: 1.6;
  padding: 6rpx 0;
  word-break: break-all;
  white-space: pre-wrap;
  border-bottom: 1rpx dashed rgba(255, 255, 255, 0.04);
}

.log-item:last-child {
  border-bottom: none;
}

.log-item .t {
  color: #6e7681;
  margin-right: 10rpx;
}

.log-item.tx .m {
  color: #2f81f7;
}

.log-item.rx .m {
  color: #3fb950;
}

.log-item.sys .m {
  color: #8b98a5;
}

.log-item.err .m {
  color: #f85149;
}

/* ---------- 提示条 ---------- */
.notice {
  border-radius: 12rpx;
  padding: 18rpx 20rpx;
  font-size: 24rpx;
  line-height: 1.6;
  margin-bottom: 24rpx;
  background: rgba(47, 129, 247, 0.1);
  border: 1rpx solid rgba(47, 129, 247, 0.3);
  color: #9ecbff;
}

.notice.warn {
  background: rgba(210, 153, 34, 0.1);
  border-color: rgba(210, 153, 34, 0.3);
  color: #e3b341;
}

.notice.err {
  background: rgba(248, 81, 73, 0.1);
  border-color: rgba(248, 81, 73, 0.3);
  color: #ff9a94;
}

/* ---------- 数值大屏 ---------- */
.metric {
  display: flex;
  gap: 20rpx;
}

.metric .box {
  flex: 1;
  background: #0d1117;
  border: 1rpx solid #262d38;
  border-radius: 12rpx;
  padding: 20rpx;
  text-align: center;
}

.metric .box .k {
  font-size: 22rpx;
  color: #6e7681;
}

.metric .box .v {
  font-family: "Cascadia Code", Consolas, monospace;
  font-size: 40rpx;
  color: #2f81f7;
  margin-top: 8rpx;
}

.metric .box .v.ok {
  color: #3fb950;
}
